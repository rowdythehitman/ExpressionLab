  { "id": "ctx.value", "label": "Value", "category": "context", "description": "The current value of the property the expression is applied to.", "tags": ["value", "self", "property"], "inputs": [], "outputs": [{ "id": "out", "label": "Value", "type": "V", "expr": "value" }], "verify": "Applied alone, the property is unchanged." },
  { "id": "ctx.time", "label": "Time", "category": "context", "description": "Current composition time in seconds.", "tags": ["time", "seconds", "clock"], "inputs": [], "outputs": [{ "id": "out", "label": "Seconds", "type": "number", "expr": "time" }], "verify": "On Rotation, the layer turns one degree per second." },
  { "id": "ctx.index", "label": "Layer Index", "category": "context", "description": "This layer's 1-based index in the composition.", "tags": ["index", "layer", "number"], "inputs": [], "outputs": [{ "id": "out", "label": "Index", "type": "number", "expr": "index" }], "verify": "On Rotation, the value equals the layer number in the timeline." },
  { "id": "ctx.inPoint", "label": "In Point", "category": "context", "description": "Comp time (seconds) at which this layer starts.", "tags": ["in", "start", "layer", "time"], "inputs": [], "outputs": [{ "id": "out", "label": "Seconds", "type": "number", "expr": "inPoint" }], "verify": "On Rotation, the value equals the layer's in point in seconds." },
  { "id": "ctx.outPoint", "label": "Out Point", "category": "context", "description": "Comp time (seconds) at which this layer ends.", "tags": ["out", "end", "layer", "time"], "inputs": [], "outputs": [{ "id": "out", "label": "Seconds", "type": "number", "expr": "outPoint" }], "verify": "On Rotation, the value equals the layer's out point in seconds." },
  { "id": "ctx.frameDuration", "label": "Frame Duration", "category": "context", "description": "Length of one frame in seconds (1 / fps).", "tags": ["frame", "duration", "fps"], "inputs": [], "outputs": [{ "id": "out", "label": "Seconds", "type": "number", "expr": "thisComp.frameDuration" }], "verify": "In a 25 fps comp, the value is 0.04." },
  { "id": "ctx.fps", "label": "Frame Rate", "category": "context", "description": "The composition's frames per second.", "tags": ["fps", "frame rate"], "inputs": [], "outputs": [{ "id": "out", "label": "FPS", "type": "number", "expr": "(1 / thisComp.frameDuration)" }], "verify": "In a 25 fps comp, the value is 25." },
  { "id": "ctx.compSize", "label": "Comp Size", "category": "context", "description": "[width, height] of the composition in pixels.", "tags": ["comp", "size", "width", "height", "resolution"], "inputs": [], "outputs": [{ "id": "out", "label": "Size", "type": "vec2", "expr": "[thisComp.width, thisComp.height]" }], "verify": "In a 1920x1080 comp, Position becomes [1920, 1080]." },
  { "id": "ctx.compCenter", "label": "Comp Center", "category": "context", "description": "The centre point of the composition.", "tags": ["comp", "center", "centre", "middle"], "inputs": [], "outputs": [{ "id": "out", "label": "Center", "type": "vec2", "expr": "[thisComp.width / 2, thisComp.height / 2]" }], "verify": "On Position, the layer sits in the middle of the comp." },
  { "id": "ctx.layerSize", "label": "Layer Size", "category": "context", "description": "[width, height] of this layer's source.", "tags": ["layer", "size", "width", "height"], "inputs": [], "outputs": [{ "id": "out", "label": "Size", "type": "vec2", "expr": "[thisLayer.width, thisLayer.height]" }], "verify": "On a 500x300 solid, the value is [500, 300]." },
  { "id": "ctx.textIndex", "label": "Text Index", "category": "context", "description": "1-based index of the character/word/line being evaluated. Only exists in an Expression Selector's Amount.", "tags": ["text", "index", "character", "selector"], "contexts": ["textSelectorAmount"], "inputs": [], "outputs": [{ "id": "out", "label": "Index", "type": "number", "expr": "textIndex" }], "verify": "With Based On = Characters, the first character gets 1." },
  { "id": "ctx.textTotal", "label": "Text Total", "category": "context", "description": "Number of characters/words/lines (per Based On). Only exists in an Expression Selector's Amount.", "tags": ["text", "total", "count", "selector"], "contexts": ["textSelectorAmount"], "inputs": [], "outputs": [{ "id": "out", "label": "Total", "type": "number", "expr": "textTotal" }], "verify": "For \"Hello\" with Based On = Characters, the value is 5." },
