  { "id": "lit.vec3", "label": "Vector 3D", "category": "context", "special": "literal", "description": "A constant [x, y, z].", "tags": ["vector", "point", "constant", "3d"], "inputs": [], "params": [{ "id": "x", "label": "X", "kind": "number", "default": 0 }, { "id": "y", "label": "Y", "kind": "number", "default": 0 }, { "id": "z", "label": "Z", "kind": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec3", "expr": "[{{param.x}}, {{param.y}}, {{param.z}}]" }] },
  { "id": "lit.color", "label": "Colour", "category": "context", "special": "literal", "description": "A constant RGBA colour, each channel 0 to 1.", "tags": ["color", "colour", "rgba", "constant"], "inputs": [], "params": [{ "id": "r", "label": "R", "kind": "number", "default": 1 }, { "id": "g", "label": "G", "kind": "number", "default": 1 }, { "id": "b", "label": "B", "kind": "number", "default": 1 }, { "id": "a", "label": "A", "kind": "number", "default": 1 }], "outputs": [{ "id": "out", "label": "Colour", "type": "color", "expr": "[{{param.r}}, {{param.g}}, {{param.b}}, {{param.a}}]" }] },
  { "id": "lit.string", "label": "Text", "category": "context", "special": "literal", "description": "A constant string.", "tags": ["string", "text", "constant"], "inputs": [], "params": [{ "id": "value", "label": "Text", "kind": "text", "default": "", "emit": "string" }], "outputs": [{ "id": "out", "label": "Text", "type": "string", "expr": "{{param.value}}" }] },
  { "id": "lit.boolean", "label": "Boolean", "category": "context", "special": "literal", "description": "A constant true/false.", "tags": ["boolean", "true", "false", "constant"], "inputs": [], "params": [{ "id": "value", "label": "Value", "kind": "checkbox", "default": true }], "outputs": [{ "id": "out", "label": "Value", "type": "boolean", "expr": "{{param.value}}" }] }
