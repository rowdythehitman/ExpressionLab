[
  { "id": "space.toComp", "label": "To Comp", "category": "space", "description": "Converts a point from a layer's space to comp space.", "tags": ["toComp", "space", "convert", "position", "null"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.toComp({{in.p}})" }], "verify": "A child layer's anchor [0, 0] maps to its comp position." },
  { "id": "space.fromComp", "label": "From Comp", "category": "space", "description": "Converts a point from comp space to a layer's space.", "tags": ["fromComp", "space", "convert"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.fromComp({{in.p}})" }], "verify": "fromComp(toComp(p)) returns p." },
  { "id": "space.toWorld", "label": "To World", "category": "space", "description": "Converts a point from a layer's space to world (3D) space.", "tags": ["toWorld", "space", "3d", "convert"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.toWorld({{in.p}})" }], "verify": "A 3D null's [0, 0, 0] maps to its world position." },
  { "id": "space.fromWorld", "label": "From World", "category": "space", "description": "Converts a point from world space to a layer's space.", "tags": ["fromWorld", "space", "3d", "convert"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.fromWorld({{in.p}})" }], "verify": "fromWorld(toWorld(p)) returns p." },
  {
    "id": "layer.sourceRect", "label": "Source Rect", "category": "space",
    "description": "The layer's bounding box (sourceRectAtTime): width, height, top, left and centre.",
    "tags": ["sourceRectAtTime", "bounds", "box", "text", "size", "width", "height", "center"],
    "inputs": [
      { "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" },
      { "id": "t", "label": "Time", "type": "number", "default": "time" }
    ],
    "params": [{ "id": "includeExtents", "label": "Include extents", "kind": "checkbox", "default": false }],
    "locals": ["r"],
    "statements": ["const {{local.r}} = {{in.layer}}.sourceRectAtTime({{in.t}}, {{param.includeExtents}});"],
    "outputs": [
      { "id": "width", "label": "Width", "type": "number", "expr": "{{local.r}}.width" },
      { "id": "height", "label": "Height", "type": "number", "expr": "{{local.r}}.height" },
      { "id": "top", "label": "Top", "type": "number", "expr": "{{local.r}}.top" },
      { "id": "left", "label": "Left", "type": "number", "expr": "{{local.r}}.left" },
      { "id": "center", "label": "Center", "type": "vec2", "expr": "[{{local.r}}.left + {{local.r}}.width / 2, {{local.r}}.top + {{local.r}}.height / 2]" }
    ],
    "verify": "On a text layer's Anchor Point, Center keeps the anchor centred as the text changes."
  },
  { "id": "layer.nameNumber", "label": "Layer Name Number", "category": "space", "description": "The number at the start of a layer's name (\"12 Title\" → 12). Handles more than one digit, unlike name[0].", "tags": ["name", "number", "dropdown", "index", "parseInt"], "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }], "outputs": [{ "id": "out", "label": "Number", "type": "number", "expr": "parseInt({{in.layer}}.name, 10)" }], "verify": "A layer named \"12 Title\" gives 12." },
  {"id": "xform.ignoreParentRotation", "label": "Ignore Parent Rotation", "category": "space", "description": "Cancels the parent's rotation so the layer keeps its own angle. 'Whole chain' also cancels grandparents.", "tags": ["parent", "rotation", "ignore", "counter", "null"], "contexts": ["transform"], "inputs": [], "params": [{"id": "chain", "label": "Whole chain", "kind": "checkbox", "default": false}], "locals": ["r", "p"], "statements": [[{"when": "param.chain == \"true\"", "text": "let {{local.r}} = value;\nlet {{local.p}} = thisLayer;\nwhile ({{local.p}}.hasParent) {\n  {{local.p}} = {{local.p}}.parent;\n  {{local.r}} -= {{local.p}}.transform.rotation;\n}"}, {"text": "const {{local.r}} = hasParent ? value - parent.transform.rotation : value;"}]], "outputs": [{"id": "out", "label": "Rotation", "type": "number", "expr": "{{local.r}}"}], "source": "aereference.com (pattern); reimplemented", "verify": "On Rotation, rotating the parent null leaves the child's on-screen angle unchanged."},
  {"id": "xform.ignoreParentScale", "label": "Ignore Parent Scale", "category": "space", "description": "Cancels the parent's scale (each axis; a 0% parent axis is left alone instead of dividing by zero). 'Whole chain' also cancels grandparents.", "tags": ["parent", "scale", "ignore", "counter", "null"], "contexts": ["transform"], "inputs": [], "params": [{"id": "chain", "label": "Whole chain", "kind": "checkbox", "default": false}], "locals": ["s", "p"], "statements": [[{"when": "param.chain == \"true\"", "text": "let {{local.s}} = value;\nlet {{local.p}} = thisLayer;\nwhile ({{local.p}}.hasParent) {\n  {{local.p}} = {{local.p}}.parent;\n  const ps = {{local.p}}.transform.scale.value;\n  {{local.s}} = {{local.s}}.map((v, i) => (ps[i] === 0 ? v : (v * 100) / ps[i]));\n}"}, {"text": "let {{local.s}} = value;\nif (hasParent) {\n  const ps = parent.transform.scale.value;\n  {{local.s}} = value.map((v, i) => (ps[i] === 0 ? v : (v * 100) / ps[i]));\n}"}]], "outputs": [{"id": "out", "label": "Scale", "type": "V", "expr": "{{local.s}}"}], "source": "aereference.com (pattern); reimplemented", "verify": "On Scale, scaling the parent to 200% leaves the child's on-screen size unchanged; a 0% parent axis doesn't error."},
  {"id": "xform.inheritParentOpacity", "label": "Inherit Parent Opacity", "category": "space", "description": "Uses the parent's opacity (AE doesn't pass opacity down). 'Keep own' multiplies it with this layer's opacity.", "tags": ["parent", "opacity", "inherit", "fade"], "inputs": [], "params": [{"id": "editable", "label": "Keep own", "kind": "checkbox", "default": true}], "outputs": [{"id": "out", "label": "Opacity", "type": "number", "expr": [{"when": "param.editable == \"true\"", "text": "(hasParent ? (parent.transform.opacity * value) / 100 : value)"}, {"text": "(hasParent ? parent.transform.opacity : value)"}]}], "source": "aereference.com (pattern); reimplemented", "verify": "On Opacity, fading the parent fades the child; with 'Keep own', a 50% child under a 50% parent shows 25%."},
  {"id": "xform.scaleToWidth", "label": "Scale to Width", "category": "space", "description": "Uniform scale that makes the layer's content exactly Width pixels wide (uses sourceRectAtTime).", "tags": ["scale", "width", "fit", "size", "text"], "contexts": ["transform"], "inputs": [{"id": "w", "label": "Width (px)", "type": "number", "default": 500}], "locals": ["rw", "s"], "statements": ["const {{local.rw}} = thisLayer.sourceRectAtTime(time, false).width;", "const {{local.s}} = {{local.rw}} > 0 ? (100 * {{in.w}}) / {{local.rw}} : 100;"], "outputs": [{"id": "out", "label": "Scale", "type": "V", "expr": [{"when": "type.V == \"vec3\"", "text": "[{{local.s}}, {{local.s}}, {{local.s}}]"}, {"when": "type.V == \"number\"", "text": "{{local.s}}"}, {"text": "[{{local.s}}, {{local.s}}]"}]}], "source": "aereference.com (pattern); reimplemented", "verify": "On Scale, a text layer stays exactly Width pixels wide as the text changes."},
  {"id": "xform.maxWidthScale", "label": "Max Width Scale", "category": "space", "description": "Scales the layer down (never up) so its content is at most Max width pixels wide. Handy for text that must fit a box.", "tags": ["scale", "width", "fit", "max", "text", "shrink"], "contexts": ["transform"], "inputs": [{"id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer"}, {"id": "maxW", "label": "Max width (px)", "type": "number", "default": 800}], "locals": ["rw", "s"], "statements": ["const {{local.rw}} = {{in.layer}}.sourceRectAtTime(time, true).width;", "const {{local.s}} = {{local.rw}} > {{in.maxW}} ? (100 * {{in.maxW}}) / {{local.rw}} : 100;"], "outputs": [{"id": "out", "label": "Scale", "type": "V", "expr": [{"when": "type.V == \"vec3\"", "text": "[{{local.s}}, {{local.s}}, {{local.s}}]"}, {"when": "type.V == \"number\"", "text": "{{local.s}}"}, {"text": "[{{local.s}}, {{local.s}}]"}]}], "source": "aereference.com (pattern); reimplemented", "verify": "On Scale, short text stays at 100%; text wider than Max width shrinks to fit."},
  {"id": "xform.maintainStrokeWidth", "label": "Maintain Stroke Width", "category": "space", "description": "Keeps a shape stroke the same on-screen width however the layer (or its parents) is scaled.", "tags": ["stroke", "width", "scale", "shape", "constant"], "contexts": ["shapeStrokeWidth"], "inputs": [], "locals": ["d"], "statements": ["const {{local.d}} = length(toComp([0, 0]), toComp([0.7071, 0.7071]));"], "outputs": [{"id": "out", "label": "Stroke width", "type": "number", "expr": "({{local.d}} > 0 ? value / {{local.d}} : value)"}], "source": "aereference.com (pattern); reimplemented", "verify": "On Stroke Width, scaling the shape layer (or its parent) to 300% keeps the stroke visually the same thickness."}
]
