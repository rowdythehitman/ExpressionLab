[
  { "id": "space.toComp", "label": "To Comp", "category": "space", "description": "Converts a point from a layer's space to comp space.", "tags": ["toComp", "space", "convert", "position", "null"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.toComp({{in.p}})" }], "verify": "A child layer's anchor [0, 0] maps to its comp position." },
  { "id": "space.fromComp", "label": "From Comp", "category": "space", "description": "Converts a point from comp space to a layer's space.", "tags": ["fromComp", "space", "convert"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.fromComp({{in.p}})" }], "verify": "fromComp(toComp(p)) returns p." },
  { "id": "space.toWorld", "label": "To World", "category": "space", "description": "Converts a point from a layer's space to world (3D) space.", "tags": ["toWorld", "space", "3d", "convert"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.toWorld({{in.p}})" }], "verify": "A 3D null's [0, 0, 0] maps to its world position." },
  { "id": "space.fromWorld", "label": "From World", "category": "space", "description": "Converts a point from world space to a layer's space.", "tags": ["fromWorld", "space", "3d", "convert"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }, { "id": "p", "label": "Point", "type": "T", "default": [0, 0, 0] }], "outputs": [{ "id": "out", "label": "Point", "type": "T", "expr": "{{in.layer}}.fromWorld({{in.p}})" }], "verify": "fromWorld(toWorld(p)) returns p." },
  {
    "id": "layer.sourceRect", "label": "Source Rect", "category": "space",
    "description": "The layer's bounding box (sourceRectAtTime): width, height, top, left and centre.",
    "tags": ["sourceRectAtTime", "bounds", "box", "text", "size", "width", "height", "center"],
    "inputs": [
      { "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" },
      { "id": "t", "label": "Time", "type": "number", "default": "time" }
