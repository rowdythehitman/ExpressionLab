[
  {
    "id": "anim.wiggle", "label": "Wiggle", "category": "animation", "noInline": true,
    "description": "Random wiggle of the target property, or of another property if wired.",
    "tags": ["wiggle", "random", "shake", "noise"],
    "inputs": [
      { "id": "freq", "label": "Freq /s", "type": "number", "default": 2 },
      { "id": "amp", "label": "Amount", "type": "number", "default": 50 },
      { "id": "prop", "label": "Property", "type": "property<V>", "optional": true }
    ],
    "params": [
      { "id": "octaves", "label": "Octaves", "kind": "number", "default": 1, "advanced": true },
      { "id": "ampMult", "label": "Amp multiplier", "kind": "number", "default": 0.5, "advanced": true }
    ],
    "outputs": [{
      "id": "out", "label": "Value", "type": "V",
      "expr": [
        { "when": "connected(prop)", "text": "{{in.prop}}.wiggle({{in.freq}}, {{in.amp}}, {{param.octaves}}, {{param.ampMult}})" },
        { "text": "wiggle({{in.freq}}, {{in.amp}}, {{param.octaves}}, {{param.ampMult}})" }
      ]
    }],
    "verify": "Position wiggles around its base value; changing the freq control changes speed."
  },
  {
    "id": "anim.loopWiggle", "label": "Looping Wiggle", "category": "animation", "noInline": true,
    "description": "Wiggle that seamlessly loops every N seconds.",
    "tags": ["wiggle", "loop", "seamless"],
    "inputs": [
      { "id": "freq", "label": "Freq /s", "type": "number", "default": 2 },
      { "id": "amp", "label": "Amount", "type": "number", "default": 40 },
      { "id": "loopSeconds", "label": "Loop (s)", "type": "number", "default": 3 }
    ],
    "locals": ["t"],
    "statements": ["const {{local.t}} = time % {{in.loopSeconds}};"],
    "outputs": [{
      "id": "out", "label": "Value", "type": "V",
      "expr": "linear({{local.t}}, 0, {{in.loopSeconds}}, wiggle({{in.freq}}, {{in.amp}}, 1, 0.5, {{local.t}}), wiggle({{in.freq}}, {{in.amp}}, 1, 0.5, {{local.t}} - {{in.loopSeconds}}))"
    }],
    "source": "aereference.com (pattern); reimplemented",
    "verify": "Frame at t and t + loopSeconds are identical."
  },
  {
    "id": "anim.loop", "label": "Loop Keyframes", "category": "animation",
    "description": "Loops the property's keyframes after the last key (out), before the first (in), or both.",
    "tags": ["loop", "loopOut", "loopIn", "cycle", "pingpong", "repeat"],
    "requires": { "keyframes": true },
    "inputs": [{ "id": "prop", "label": "Property", "type": "property<V>", "optional": true }],
    "params": [
      { "id": "mode", "label": "Mode", "kind": "select", "options": ["cycle", "pingpong", "offset", "continue"], "default": "cycle", "emit": "string" },
      { "id": "dir", "label": "Direction", "kind": "select", "options": ["out", "in", "both"], "default": "out" }
    ],
    "outputs": [{
      "id": "out", "label": "Value", "type": "V",
      "expr": [
        { "when": "param.dir == \"out\" && connected(prop)", "text": "{{in.prop}}.loopOut({{param.mode}})" },
        { "when": "param.dir == \"out\"", "text": "loopOut({{param.mode}})" },
        { "when": "param.dir == \"in\" && connected(prop)", "text": "{{in.prop}}.loopIn({{param.mode}})" },
        { "when": "param.dir == \"in\"", "text": "loopIn({{param.mode}})" },
        { "when": "connected(prop) && type.V == \"number\"", "text": "{{in.prop}}.loopIn({{param.mode}}) + {{in.prop}}.loopOut({{param.mode}}) - {{in.prop}}.value" },
        { "when": "connected(prop)", "text": "sub(add({{in.prop}}.loopIn({{param.mode}}), {{in.prop}}.loopOut({{param.mode}})), {{in.prop}}.value)" },
        { "when": "type.V == \"number\"", "text": "loopIn({{param.mode}}) + loopOut({{param.mode}}) - value" },
        { "text": "sub(add(loopIn({{param.mode}}), loopOut({{param.mode}})), value)" }
      ]
    }],
    "verify": "With 2 keyframes, the animation repeats after the last key (out) and before the first key (in / both)."
  },
  {
    "id": "anim.valueAtTime", "label": "Value at Time", "category": "animation",
    "description": "A property's value at another time, e.g. time - delay. Reference a fixed layer, not index - 1.",
    "tags": ["valueAtTime", "delay", "offset", "time", "echo", "follow"],
    "generics": { "T": ["number", "vec2", "vec3", "color", "string"] },
    "inputs": [
      { "id": "prop", "label": "Property", "type": "property<T>" },
      { "id": "t", "label": "Time", "type": "number", "default": "time" }
    ],
    "outputs": [{ "id": "out", "label": "Value", "type": "T", "expr": "{{in.prop}}.valueAtTime({{in.t}})" }],
    "verify": "With t = time - 0.5, the layer follows the referenced property half a second late."
  },
  {
    "id": "anim.delayByIndex", "label": "Delay by Index", "category": "animation",
    "description": "frames × frameDuration × (index - 1): a per-layer delay in seconds. Feed it into Value at Time (time - delay) on a fixed layer.",
    "tags": ["delay", "stagger", "offset", "index", "cascade"],
    "inputs": [{ "id": "frames", "label": "Frames", "type": "number", "default": 2 }],
    "outputs": [{ "id": "out", "label": "Seconds", "type": "number", "expr": "{{in.frames}} * thisComp.frameDuration * (index - 1)" }],
    "verify": "Layer 3 with frames = 2 returns 4 frames' worth of seconds."
  },
  {
    "id": "anim.posterize", "label": "Posterize Time", "category": "animation",
    "description": "Evaluates the whole expression at a lower frame rate (stop-motion look).",
    "tags": ["posterize", "fps", "stop motion", "choppy", "framerate"],
    "hoist": "top", "hoistKey": "posterizeTime",
    "inputs": [{ "id": "fps", "label": "FPS", "type": "number", "default": 12 }],
    "statements": ["posterizeTime({{in.fps}});"],
    "outputs": [],
    "verify": "With Wiggle downstream, the wiggle updates only fps times per second."
  },
  {"id": "anim.wiggleRange", "label": "Wiggle Between", "category": "animation", "noInline": true, "description": "Wiggles smoothly between Min and Max (instead of around the property's value).", "tags": ["wiggle", "range", "between", "min", "max", "random"], "inputs": [{"id": "freq", "label": "Freq /s", "type": "number", "default": 2}, {"id": "min", "label": "Min", "type": "number", "default": 0}, {"id": "max", "label": "Max", "type": "number", "default": 100}], "outputs": [{"id": "out", "label": "Value", "type": "V", "expr": [{"when": "type.V == \"number\"", "text": "wiggle({{in.freq}}, ({{in.max}} - {{in.min}}) / 2, 1) - value + ({{in.max}} + {{in.min}}) / 2"}, {"text": "sub(wiggle({{in.freq}}, ({{in.max}} - {{in.min}}) / 2, 1), value).map((v) => v + ({{in.max}} + {{in.min}}) / 2)"}]}], "source": "aereference.com (pattern); reimplemented", "verify": "On Opacity with Min 20 / Max 80, opacity wanders between roughly 20 and 80 whatever its keyframed value."},
  {"id": "anim.loopPath", "label": "Loop Path Keyframes", "category": "animation", "description": "Cycles a path's keyframes after the last key (loopOut doesn't work on paths).", "tags": ["loop", "path", "mask", "shape", "cycle"], "requires": {"keyframes": true}, "inputs": [], "locals": ["t"], "statements": ["let {{local.t}} = time;\nif (numKeys > 1 && time > key(numKeys).time) {\n  const t1 = key(1).time;\n  const span = key(numKeys).time - t1;\n  {{local.t}} = t1 + ((time - t1) % span);\n}"], "outputs": [{"id": "out", "label": "Path", "type": "V", "expr": "valueAtTime({{local.t}})"}], "source": "aereference.com (pattern); reimplemented", "verify": "On a Path with 3 keyframes, the shape animation repeats after the last keyframe."},
  {"id": "key.previous", "label": "Previous Keyframe", "category": "animation", "description": "The keyframe at or before the current time on this property (AE 26 previousKey). Falls back to the first key.", "tags": ["keyframe", "previous", "key", "overshoot", "trigger", "ae26"], "requires": {"minAE": 26, "keyframes": true}, "inputs": [], "locals": ["k"], "statements": ["const {{local.k}} = numKeys > 0 ? thisProperty.previousKey(time) : null;"], "outputs": [{"id": "time", "label": "Time", "type": "number", "expr": "({{local.k}} ? {{local.k}}.time : 0)"}, {"id": "value", "label": "Value", "type": "V", "expr": "({{local.k}} ? {{local.k}}.value : value)"}], "verify": "With keys at 1s and 3s, Time reads 1 between them and 3 after the last key."},
  {"id": "key.next", "label": "Next Keyframe", "category": "animation", "description": "The keyframe after the current time on this property (AE 26 nextKey). Falls back to the last key.", "tags": ["keyframe", "next", "key", "anticipation", "ae26"], "requires": {"minAE": 26, "keyframes": true}, "inputs": [], "locals": ["k"], "statements": ["const {{local.k}} = numKeys > 0 ? thisProperty.nextKey(time) : null;"], "outputs": [{"id": "time", "label": "Time", "type": "number", "expr": "({{local.k}} ? {{local.k}}.time : 0)"}, {"id": "value", "label": "Value", "type": "V", "expr": "({{local.k}} ? {{local.k}}.value : value)"}], "verify": "With keys at 1s and 3s, Time reads 3 between them."}
]
