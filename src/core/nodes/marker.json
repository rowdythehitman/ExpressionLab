[
  {
    "id": "marker.sinceLast", "label": "Time Since Marker", "category": "marker",
    "description": "Seconds since the most recent marker on this layer. Use to trigger animations.",
    "tags": ["marker", "trigger", "timing"],
    "inputs": [],
    "locals": ["n"],
    "statements": [
      "let {{local.n}} = 0;",
      "if (marker.numKeys > 0) {",
      "  {{local.n}} = marker.nearestKey(time).index;",
      "  if (marker.key({{local.n}}).time > time) { {{local.n}}--; }",
      "}"
    ],
    "outputs": [
      { "id": "since", "label": "Seconds", "type": "number", "expr": "({{local.n}} > 0 ? time - marker.key({{local.n}}).time : 0)" },
      { "id": "active", "label": "Passed any", "type": "boolean", "expr": "({{local.n}} > 0)" }
    ],
    "verify": "Before the first marker 'since' is 0 and 'active' is false."
  },
  {"id": "marker.current", "label": "Current Marker", "category": "marker", "description": "The most recent marker on this layer: its time, duration and comment. Use for marker-driven fades and labels.", "tags": ["marker", "duration", "comment", "fade", "current"], "inputs": [], "locals": ["n"], "statements": ["let {{local.n}} = 0;\nif (marker.numKeys > 0) {\n  {{local.n}} = marker.nearestKey(time).index;\n  if (marker.key({{local.n}}).time > time) { {{local.n}}--; }\n}"], "outputs": [{"id": "time", "label": "Time", "type": "number", "expr": "({{local.n}} > 0 ? marker.key({{local.n}}).time : 0)"}, {"id": "duration", "label": "Duration", "type": "number", "expr": "({{local.n}} > 0 ? marker.key({{local.n}}).duration : 0)"}, {"id": "comment", "label": "Comment", "type": "string", "expr": "({{local.n}} > 0 ? marker.key({{local.n}}).comment : \"\")"}, {"id": "active", "label": "Passed any", "type": "boolean", "expr": "({{local.n}} > 0)"}], "verify": "On a text layer's Source Text wired to Comment, the text shows the comment of the marker most recently passed."},
  {"id": "marker.previous", "label": "Previous Marker (AE 26)", "category": "marker", "description": "marker.previousKey(time): the marker at or before now. Before the first marker AE returns the first marker, so check 'Passed'.", "tags": ["marker", "previous", "ae26", "trigger"], "requires": {"minAE": 26}, "inputs": [], "locals": ["m"], "statements": ["const {{local.m}} = marker.numKeys > 0 ? marker.previousKey(time) : null;"], "outputs": [{"id": "time", "label": "Time", "type": "number", "expr": "({{local.m}} ? {{local.m}}.time : 0)"}, {"id": "comment", "label": "Comment", "type": "string", "expr": "({{local.m}} ? {{local.m}}.comment : \"\")"}, {"id": "passed", "label": "Passed", "type": "boolean", "expr": "({{local.m}} !== null && {{local.m}}.time <= time)"}], "verify": "Between two markers, Time reads the earlier marker's time; before the first marker Passed is false."}
]
