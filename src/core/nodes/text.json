[
  { "id": "text.sourceText", "label": "Source Text", "category": "text", "description": "The text of a text layer (this layer if none is wired).", "tags": ["text", "string", "source"], "inputs": [{ "id": "layer", "label": "Layer", "type": "layer", "default": "thisLayer" }], "outputs": [{ "id": "out", "label": "Text", "type": "string", "expr": "{{in.layer}}.text.sourceText.value" }], "verify": "On another text layer's Source Text, it mirrors the referenced layer." },
  { "id": "text.fromNumber", "label": "Number to Text", "category": "text", "description": "Formats a number with a fixed number of decimals.", "tags": ["text", "number", "format", "decimals", "counter"], "inputs": [{ "id": "n", "label": "Number", "type": "number", "default": 0 }], "params": [{ "id": "decimals", "label": "Decimals", "kind": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Text", "type": "string", "expr": "({{in.n}}).toFixed({{param.decimals}})" }], "verify": "On Source Text with n = time, decimals = 1, it counts 0.0, 0.1, ..." },
  { "id": "string.concat", "label": "Join Text", "category": "text", "description": "A + B as text.", "tags": ["text", "concat", "join", "append", "string"], "inputs": [{ "id": "a", "label": "A", "type": "string", "default": "" }, { "id": "b", "label": "B", "type": "string", "default": "" }], "outputs": [{ "id": "out", "label": "Text", "type": "string", "expr": "{{in.a}} + {{in.b}}" }], "verify": "\"Score: \" + Number to Text shows a label and value." },
  {
    "id": "text.stagger", "label": "Stagger", "category": "text",
    "description": "Per-character (or word/line) animation offset: each element starts a few frames after the previous one. Use on an Expression Selector's Amount.",
    "tags": ["text", "stagger", "cascade", "delay", "animate in", "selector", "textIndex"],
    "contexts": ["textSelectorAmount"],
    "inputs": [
      { "id": "start", "label": "Start (s)", "type": "number", "default": "inPoint" },
      { "id": "delayFrames", "label": "Delay (frames)", "type": "number", "default": 2 },
      { "id": "durFrames", "label": "Duration (frames)", "type": "number", "default": 8 },
      { "id": "from", "label": "From", "type": "number", "default": 100 },
      { "id": "to", "label": "To", "type": "number", "default": 0 }
    ],
    "params": [{ "id": "mode", "label": "Easing", "kind": "select", "options": ["ease", "linear", "easeIn", "easeOut"], "default": "ease" }],
    "locals": ["start"],
    "statements": ["const {{local.start}} = {{in.start}} + (textIndex - 1) * {{in.delayFrames}} * thisComp.frameDuration;"],
    "outputs": [{ "id": "out", "label": "Amount", "type": "number", "expr": "{{param.mode}}(time, {{local.start}}, {{local.start}} + {{in.durFrames}} * thisComp.frameDuration, {{in.from}}, {{in.to}})" }],
    "verify": "With a Position animator, characters slide in one after another, 2 frames apart."
  },
  {
    "id": "text.typewriter", "label": "Typewriter", "category": "text",
    "description": "100 for elements not yet typed, 0 once typed. Pair with an Opacity 0% animator on an Expression Selector.",
    "tags": ["text", "typewriter", "type on", "reveal", "selector", "textIndex"],
    "contexts": ["textSelectorAmount"],
    "inputs": [
      { "id": "start", "label": "Start (s)", "type": "number", "default": "inPoint" },
      { "id": "cps", "label": "Chars / s", "type": "number", "default": 20 }
    ],
    "outputs": [{ "id": "out", "label": "Amount", "type": "number", "expr": "(textIndex - 1 >= (time - {{in.start}}) * {{in.cps}} ? 100 : 0)" }],
    "verify": "With an Opacity 0% animator, the text types on at 20 characters per second from the layer's in point."
  },
  {
    "id": "text.ramp", "label": "Index Ramp", "category": "text",
    "description": "0 on the first element up to Amount on the last (textIndex / textTotal), e.g. for gradients across characters.",
    "tags": ["text", "ramp", "gradient", "selector", "textIndex", "textTotal"],
    "contexts": ["textSelectorAmount"],
    "inputs": [{ "id": "amount", "label": "Amount", "type": "number", "default": 100 }],
    "outputs": [{ "id": "out", "label": "Amount", "type": "number", "expr": "{{in.amount}} * (textIndex - 1) / Math.max(1, textTotal - 1)" }],
    "verify": "With a Fill Colour animator the first character is unaffected and the last fully affected."
  },
  {"id": "date.format", "label": "Current Date", "category": "text", "description": "Today's date (when AE renders, not comp time) as text, in the chosen format.", "tags": ["date", "today", "time", "format", "text", "calendar"], "inputs": [], "params": [{"id": "format", "label": "Format", "kind": "select", "options": ["YYYY-MM-DD", "DD/MM/YYYY", "MM/DD/YYYY", "D Month YYYY", "Month D, YYYY"], "default": "D Month YYYY"}], "locals": ["d", "pad", "months"], "statements": ["const {{local.d}} = new Date();", "const {{local.pad}} = (n) => String(n).padStart(2, \"0\");", [{"when": "param.format == \"D Month YYYY\" || param.format == \"Month D, YYYY\"", "text": "const {{local.months}} = [\"January\", \"February\", \"March\", \"April\", \"May\", \"June\", \"July\", \"August\", \"September\", \"October\", \"November\", \"December\"];"}, {"text": ""}]], "outputs": [{"id": "out", "label": "Text", "type": "string", "expr": [{"when": "param.format == \"YYYY-MM-DD\"", "text": "`${{{local.d}}.getFullYear()}-${{{local.pad}}({{local.d}}.getMonth() + 1)}-${{{local.pad}}({{local.d}}.getDate())}`"}, {"when": "param.format == \"DD/MM/YYYY\"", "text": "`${{{local.pad}}({{local.d}}.getDate())}/${{{local.pad}}({{local.d}}.getMonth() + 1)}/${{{local.d}}.getFullYear()}`"}, {"when": "param.format == \"MM/DD/YYYY\"", "text": "`${{{local.pad}}({{local.d}}.getMonth() + 1)}/${{{local.pad}}({{local.d}}.getDate())}/${{{local.d}}.getFullYear()}`"}, {"when": "param.format == \"Month D, YYYY\"", "text": "`${{{local.months}}[{{local.d}}.getMonth()]} ${{{local.d}}.getDate()}, ${{{local.d}}.getFullYear()}`"}, {"text": "`${{{local.d}}.getDate()} ${{{local.months}}[{{local.d}}.getMonth()]} ${{{local.d}}.getFullYear()}`"}]}], "source": "aereference.com (pattern); reimplemented", "verify": "On Source Text, shows today's date in the chosen format and updates on the next day's render."}
]
