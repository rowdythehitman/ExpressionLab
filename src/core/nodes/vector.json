[
  { "id": "vec.make2", "label": "Make Vec2", "category": "vector", "description": "Builds [x, y] from two numbers.", "tags": ["vector", "combine", "make", "2d", "point"], "inputs": [{ "id": "x", "label": "X", "type": "number", "default": 0 }, { "id": "y", "label": "Y", "type": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec2", "expr": "[{{in.x}}, {{in.y}}]" }], "verify": "On Position with x = 100, y = 200 the layer sits at (100, 200)." },
  { "id": "vec.make3", "label": "Make Vec3", "category": "vector", "description": "Builds [x, y, z] from three numbers.", "tags": ["vector", "combine", "make", "3d", "point"], "inputs": [{ "id": "x", "label": "X", "type": "number", "default": 0 }, { "id": "y", "label": "Y", "type": "number", "default": 0 }, { "id": "z", "label": "Z", "type": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec3", "expr": "[{{in.x}}, {{in.y}}, {{in.z}}]" }], "verify": "On 3D Position the layer sits at (x, y, z)." },
  { "id": "vec.makeColor", "label": "Make Colour", "category": "vector", "description": "Builds an RGBA colour from four 0-1 channels.", "tags": ["color", "colour", "rgba", "make"], "inputs": [{ "id": "r", "label": "R", "type": "number", "default": 1 }, { "id": "g", "label": "G", "type": "number", "default": 1 }, { "id": "b", "label": "B", "type": "number", "default": 1 }, { "id": "a", "label": "A", "type": "number", "default": 1 }], "outputs": [{ "id": "out", "label": "Colour", "type": "color", "expr": "[{{in.r}}, {{in.g}}, {{in.b}}, {{in.a}}]" }], "verify": "On a Fill colour, r = 1, g = 0, b = 0 gives red." },
  { "id": "vec.split2", "label": "Split Vec2", "category": "vector", "description": "Splits [x, y] into two numbers.", "tags": ["vector", "split", "separate", "x", "y"], "inputs": [{ "id": "v", "label": "Vector", "type": "vec2" }], "outputs": [{ "id": "x", "label": "X", "type": "number", "expr": "{{in.v}}[0]" }, { "id": "y", "label": "Y", "type": "number", "expr": "{{in.v}}[1]" }], "verify": "Split of Position then Make Vec2 leaves the layer where it was." },
  { "id": "vec.split3", "label": "Split Vec3", "category": "vector", "description": "Splits [x, y, z] into three numbers.", "tags": ["vector", "split", "separate", "x", "y", "z"], "inputs": [{ "id": "v", "label": "Vector", "type": "vec3" }], "outputs": [{ "id": "x", "label": "X", "type": "number", "expr": "{{in.v}}[0]" }, { "id": "y", "label": "Y", "type": "number", "expr": "{{in.v}}[1]" }, { "id": "z", "label": "Z", "type": "number", "expr": "{{in.v}}[2]" }], "verify": "Split of 3D Position then Make Vec3 leaves the layer where it was." },
  { "id": "vec.splitColor", "label": "Split Colour", "category": "vector", "description": "Splits a colour into R, G, B, A.", "tags": ["color", "colour", "split", "rgba"], "inputs": [{ "id": "v", "label": "Colour", "type": "color" }], "outputs": [{ "id": "r", "label": "R", "type": "number", "expr": "{{in.v}}[0]" }, { "id": "g", "label": "G", "type": "number", "expr": "{{in.v}}[1]" }, { "id": "b", "label": "B", "type": "number", "expr": "{{in.v}}[2]" }, { "id": "a", "label": "A", "type": "number", "expr": "{{in.v}}[3]" }], "verify": "Split then Make Colour leaves the colour unchanged." },
  { "id": "vec.pick", "label": "Pick Component", "category": "vector", "description": "One component of a vector (0 = x/r, 1 = y/g, 2 = z/b, 3 = a).", "tags": ["vector", "component", "pick", "index", "converter"], "generics": { "T": ["vec2", "vec3", "color"] }, "inputs": [{ "id": "v", "label": "Vector", "type": "T", "default": [0, 0] }], "params": [{ "id": "index", "label": "Component", "kind": "select", "options": ["0", "1", "2", "3"], "default": "0" }], "outputs": [{ "id": "out", "label": "Number", "type": "number", "expr": "{{in.v}}[{{param.index}}]" }], "verify": "Pick 1 of Position equals the Y position." },
  { "id": "vec.broadcast2", "label": "Broadcast to Vec2", "category": "vector", "description": "[n, n], e.g. uniform scale from one number.", "tags": ["vector", "broadcast", "uniform", "converter"], "inputs": [{ "id": "n", "label": "Number", "type": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec2", "expr": "[{{in.n}}, {{in.n}}]" }], "verify": "On Scale, 50 gives [50, 50]." },
  { "id": "vec.broadcast3", "label": "Broadcast to Vec3", "category": "vector", "description": "[n, n, n].", "tags": ["vector", "broadcast", "uniform", "converter"], "inputs": [{ "id": "n", "label": "Number", "type": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec3", "expr": "[{{in.n}}, {{in.n}}, {{in.n}}]" }], "verify": "On 3D Scale, 50 gives [50, 50, 50]." },
  { "id": "vec.dropZ", "label": "Drop Z", "category": "vector", "description": "[x, y, z] → [x, y].", "tags": ["vector", "2d", "3d", "converter"], "inputs": [{ "id": "v", "label": "Vector", "type": "vec3" }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec2", "expr": "[{{in.v}}[0], {{in.v}}[1]]" }], "verify": "A 3D point [1, 2, 3] becomes [1, 2]." },
  { "id": "vec.addZ", "label": "Add Z", "category": "vector", "description": "[x, y] → [x, y, z].", "tags": ["vector", "2d", "3d", "converter"], "inputs": [{ "id": "v", "label": "Vector", "type": "vec2" }, { "id": "z", "label": "Z", "type": "number", "default": 0 }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec3", "expr": "[{{in.v}}[0], {{in.v}}[1], {{in.z}}]" }], "verify": "[1, 2] becomes [1, 2, 0]." },
  { "id": "vec.dropAlpha", "label": "Drop Alpha", "category": "vector", "description": "[r, g, b, a] → [r, g, b].", "tags": ["color", "colour", "alpha", "converter"], "inputs": [{ "id": "v", "label": "Colour", "type": "color" }], "outputs": [{ "id": "out", "label": "Vector", "type": "vec3", "expr": "[{{in.v}}[0], {{in.v}}[1], {{in.v}}[2]]" }], "verify": "[1, 0.5, 0, 1] becomes [1, 0.5, 0]." },
  { "id": "vec.length", "label": "Length", "category": "vector", "description": "Magnitude of a vector, or the distance to B when wired.", "tags": ["length", "magnitude", "distance"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "a", "label": "A", "type": "T", "default": [0, 0] }, { "id": "b", "label": "B", "type": "T", "optional": true }], "outputs": [{ "id": "out", "label": "Length", "type": "number", "expr": [{ "when": "connected(b)", "text": "length({{in.a}}, {{in.b}})" }, { "text": "length({{in.a}})" }] }], "verify": "length([3, 4]) is 5." },
  { "id": "vec.distance", "label": "Distance", "category": "vector", "description": "Distance between two points.", "tags": ["distance", "length", "proximity"], "generics": { "T": ["vec2", "vec3"] }, "inputs": [{ "id": "a", "label": "A", "type": "T", "default": [0, 0] }, { "id": "b", "label": "B", "type": "T", "default": [0, 0] }], "outputs": [{ "id": "out", "label": "Distance", "type": "number", "expr": "length({{in.a}}, {{in.b}})" }], "verify": "Distance between [0, 0] and [3, 4] is 5." }
]
