[
  { "id": "logic.compare", "label": "Compare", "category": "logic", "description": "Compares two numbers.", "tags": ["compare", "greater", "less", "equal", "if", "condition"], "inputs": [{ "id": "a", "label": "A", "type": "number", "default": 0 }, { "id": "b", "label": "B", "type": "number", "default": 0 }], "params": [{ "id": "op", "label": "Operator", "kind": "select", "options": [">", "<", ">=", "<=", "==", "!="], "default": ">" }], "outputs": [{ "id": "out", "label": "Result", "type": "boolean", "expr": "({{in.a}} {{param.op}} {{in.b}})" }], "verify": "time > 1 switches a Select after one second." },
  { "id": "logic.and", "label": "And", "category": "logic", "description": "True when both are true.", "tags": ["and", "both", "boolean"], "inputs": [{ "id": "a", "label": "A", "type": "boolean", "default": true }, { "id": "b", "label": "B", "type": "boolean", "default": true }], "outputs": [{ "id": "out", "label": "Result", "type": "boolean", "expr": "({{in.a}} && {{in.b}})" }] },
  { "id": "logic.or", "label": "Or", "category": "logic", "description": "True when either is true.", "tags": ["or", "either", "boolean"], "inputs": [{ "id": "a", "label": "A", "type": "boolean", "default": false }, { "id": "b", "label": "B", "type": "boolean", "default": false }], "outputs": [{ "id": "out", "label": "Result", "type": "boolean", "expr": "({{in.a}} || {{in.b}})" }] },
  { "id": "logic.not", "label": "Not", "category": "logic", "description": "Inverts a boolean.", "tags": ["not", "invert", "boolean"], "inputs": [{ "id": "a", "label": "A", "type": "boolean", "default": false }], "outputs": [{ "id": "out", "label": "Result", "type": "boolean", "expr": "!{{in.a}}" }] },
  { "id": "logic.select", "label": "Select", "category": "logic", "description": "Picks A when the condition is true, otherwise B.", "tags": ["select", "if", "else", "switch", "ternary", "condition"], "generics": { "T": ["number", "vec2", "vec3", "color", "string"] }, "inputs": [{ "id": "cond", "label": "If", "type": "boolean", "default": true }, { "id": "a", "label": "Then", "type": "T", "default": 0 }, { "id": "b", "label": "Else", "type": "T", "default": 0 }], "outputs": [{ "id": "out", "label": "Result", "type": "T", "expr": "({{in.cond}} ? {{in.a}} : {{in.b}})" }], "verify": "With If = hasParent, the output switches when the parent is set." },
  { "id": "logic.checkboxGate", "label": "Checkbox Gate", "category": "logic", "description": "value × checkbox: passes the value when the checkbox is on, 0 when off.", "tags": ["checkbox", "gate", "toggle", "enable", "on", "off"], "generics": { "T": ["number", "vec2", "vec3", "color"] }, "inputs": [{ "id": "v", "label": "Value", "type": "T", "default": 0 }, { "id": "checkbox", "label": "Checkbox", "type": "number", "default": 1 }], "outputs": [{ "id": "out", "label": "Result", "type": "T", "expr": [{ "when": "type.T == \"number\"", "text": "{{in.v}} * {{in.checkbox}}" }, { "text": "mul({{in.v}}, {{in.checkbox}})" }] }], "verify": "On Opacity, unticking the checkbox hides the layer." }
]
